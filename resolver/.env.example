# Daftar dan arti: source/docs/ARCHITECTURE.md bagian 8 dan source/docs/RESOLVER_SERVICE.md bagian 4.
# Default planner/faucet/resolver diambil dari source/sot/constants.json; isi di sini hanya untuk override.
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_WS=
LIVE_MARKET_ADDRESS=
MOCK_USDC_ADDRESS=
DEPLOY_BLOCK=
RESOLVER_PRIVATE_KEY=
FAUCET_PRIVATE_KEY=
ADMIN_TOKEN=
CRE_MODE=simulate
CRE_PROJECT_DIR=../cre
CRE_TARGET=staging-settings
CORS_ORIGIN=http://localhost:5173
PORT=8787
REPLAY_POOL=
TRUST_PROXY=false
# Hanya untuk container (CRE_MODE=simulate): dibaca CLI `cre` dari env proses, diteruskan runner ke proses anak.
# Lokal tidak perlu: backend/cre/.env menang atas env proses (CLI v1.33.0). Lihat backend/README.md bagian Deploy.
# CRE_ETH_PRIVATE_KEY=
# Alternatif sesi `cre login` (butuh deploy access disetujui, `cre account access`).
# CRE_API_KEY=
